
{
  "actorSpecification": 1,
  "name": "google-maps-scraper",
  "title": "Google Maps Scraper",
  "description": "Scrape places from Google Maps by search terms and location. Get name, address, phone, rating, reviews, website and more.",
  "version": "1.0",
  "buildTag": "latest",
  "environmentVariables": {},
  "dockerfile": "./Dockerfile",
  "readme": "./README.md",
  "input": "./input_schema.json",

  "output": {
    "actorOutputSchemaVersion": 1,
    "title": "Google Maps Scraper Output",
    "description": "Scraped Google Maps place data including business details, website enrichment, contact information and more.",
    "properties": {
      "results": {
        "type": "string",
        "title": "Google Maps Places",
        "template": "{{links.apiDefaultDatasetUrl}}/items"
      }
    }
  },

  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "title": "Scraped Places",
      "views": {
        "overview": {
          "title": "Overview",
          "transformation": {
            "fields": [
              "place_id",
              "name",
              "category",
              "rating",
              "review_count",
              "price",
              "address",
              "phone",
              "website",
              "email",
              "maps_url",
              "ws_title",
              "ws_emails",
              "ws_phones",
              "ws_social_links",
              "ws_description",
              "ws_legal_name",
              "ws_founding_date",
              "ws_employees",
              "ws_has_contact_form",
              "ws_address",
              "ws_logo",
              "ws_scrape_status"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "place_id": {
                "label": "Place ID",
                "format": "text"
              },
              "name": {
                "label": "Name",
                "format": "text"
              },
              "category": {
                "label": "Category",
                "format": "text"
              },
              "rating": {
                "label": "Rating",
                "format": "text"
              },
              "review_count": {
                "label": "Review Count",
                "format": "text"
              },
              "price": {
                "label": "Price",
                "format": "text"
              },
              "address": {
                "label": "Address",
                "format": "text"
              },
              "phone": {
                "label": "Phone",
                "format": "text"
              },
              "website": {
                "label": "Website",
                "format": "link"
              },
              "email": {
                "label": "Email",
                "format": "text"
              },
              "maps_url": {
                "label": "Maps URL",
                "format": "link"
              },
              "ws_title": {
                "label": "Website Title",
                "format": "text"
              },
              "ws_emails": {
                "label": "Website Emails",
                "format": "text"
              },
              "ws_phones": {
                "label": "Website Phones",
                "format": "text"
              },
              "ws_social_links": {
                "label": "Social Links",
                "format": "text"
              },
              "ws_description": {
                "label": "Website Description",
                "format": "text"
              },
              "ws_legal_name": {
                "label": "Legal Name",
                "format": "text"
              },
              "ws_founding_date": {
                "label": "Founding Date",
                "format": "text"
              },
              "ws_employees": {
                "label": "Employees",
                "format": "text"
              },
              "ws_has_contact_form": {
                "label": "Has Contact Form",
                "format": "text"
              },
              "ws_address": {
                "label": "Website Address",
                "format": "text"
              },
              "ws_logo": {
                "label": "Website Logo",
                "format": "link"
              },
              "ws_scrape_status": {
                "label": "Website Scrape Status",
                "format": "text"
              }
            }
          }
        }
      }
    }
  }
}
