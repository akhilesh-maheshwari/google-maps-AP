{
  "title": "Google Maps Scraper Input",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "fileName": {
      "title": "File Name",
      "type": "string",
      "description": "Name for the output file",
      "editor": "textfield",
      "default": "output"
    },
    "searchTerms": {
      "title": "Search term(s)",
      "type": "array",
      "description": "List of search terms",
      "editor": "stringList",
      "prefill": ["hospitals"]
    },
    "location": {
      "title": "Location",
      "type": "string",
      "description": "Use only one location per run",
      "editor": "textfield",
      "prefill": "New York, USA"
    },
    "maxPlaces": {
      "title": "Number of places to extract (per search term)",
      "type": "integer",
      "description": "Maximum number of places to scrape for each search term",
      "editor": "number",
      "prefill": 150
    },
    "language": {
      "title": "Language",
      "type": "string",
      "description": "Language for Google Maps results",
      "editor": "select",
      "enum": [
        "en",
        "ar",
        "bg",
        "bn",
        "ca",
        "cs",
        "da",
        "de",
        "el",
        "es",
        "et",
        "fa",
        "fi",
        "fil",
        "fr",
        "gu",
        "he",
        "hi",
        "hr",
        "hu",
        "id",
        "it",
        "ja",
        "kn",
        "ko",
        "lt",
        "lv",
        "ml",
        "mr",
        "nl",
        "no",
        "pl",
        "pt",
        "ro",
        "ru",
        "sk",
        "sl",
        "sr",
        "sv",
        "ta",
        "te",
        "th",
        "tr",
        "uk",
        "ur",
        "vi",
        "zh"
      ],
      "enumTitles": [
        "English",
        "Arabic",
        "Bulgarian",
        "Bengali",
        "Catalan",
        "Czech",
        "Danish",
        "German",
        "Greek",
        "Spanish",
        "Estonian",
        "Persian",
        "Finnish",
        "Filipino",
        "French",
        "Gujarati",
        "Hebrew",
        "Hindi",
        "Croatian",
        "Hungarian",
        "Indonesian",
        "Italian",
        "Japanese",
        "Kannada",
        "Korean",
        "Lithuanian",
        "Latvian",
        "Malayalam",
        "Marathi",
        "Dutch",
        "Norwegian",
        "Polish",
        "Portuguese",
        "Romanian",
        "Russian",
        "Slovak",
        "Slovenian",
        "Serbian",
        "Swedish",
        "Tamil",
        "Telugu",
        "Thai",
        "Turkish",
        "Ukrainian",
        "Urdu",
        "Vietnamese",
        "Chinese"
      ],
      "default": "en"
    }
  },
  "required": ["searchTerms", "location"]
}
