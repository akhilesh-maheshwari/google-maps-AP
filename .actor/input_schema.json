{
  "title": "Google Maps Scraper Input",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "fileName": {
      "title": "File Name",
      "type": "string",
      "description": "Name for the output file",
      "editor": "textfield",
      "default": "output"
    },
    "searchTerms": {
      "title": "Search term(s)",
      "type": "array",
      "description": "List of search terms",
      "editor": "stringList",
      "prefill": ["hospitals"]
    },
    "location": {
      "title": "📍 Location (use only one location per run)",
      "type": "string",
      "description": "Use only one location per run",
      "editor": "textfield",
      "prefill": "New York"
    },
    "country": {
      "title": "🌍 Country",
